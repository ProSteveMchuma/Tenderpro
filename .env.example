# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SupplierOS Africa
NODE_ENV=development

# Demo mode runs the full product locally without live vendor credentials.
DEMO_MODE=true
DEMO_SEED_ON_BOOT=true

# Session signing for local/demo auth. Generate a long random string.
SESSION_SECRET=replace-with-a-long-random-secret

# Database driver: firestore (default) | postgres | pglite
DATABASE_DRIVER=firestore

# Firebase / Firestore (project tenderpro-480721)
# Public web config — used by the client SDK. Not a secret.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCV5dz7faG0dnHGjtyVBkH0jKHZiByoUoc
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tenderpro-480721.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tenderpro-480721
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tenderpro-480721.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=336800880016
NEXT_PUBLIC_FIREBASE_APP_ID=1:336800880016:web:71fd96ae334e0961ab0f15
FIREBASE_PROJECT_ID=tenderpro-480721
# Local demo uses .data/firestore/db.json until a service account is set.
# Server Admin SDK (required to write to Cloud Firestore):
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional: point Admin SDK at the emulator
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Force cloud mode (requires credentials or emulator)
FIREBASE_USE_CLOUD=false
# Optional: override the local document-store file path (used by tests)
# FIRESTORE_LOCAL_PATH=

# Legacy Postgres (only when DATABASE_DRIVER=postgres)
DATABASE_URL=

# Supabase (optional storage / legacy)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUTH_REDIRECT_URL=http://localhost:3000/auth/callback

# File storage
# local | supabase | firebase
STORAGE_DRIVER=local
SUPABASE_STORAGE_BUCKET=organization-files
MAX_UPLOAD_BYTES=15728640

# AI
# openai | mock
AI_PROVIDER=mock
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=45000

# Email
# resend | console
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=SupplierOS Africa <noreply@example.com>

# WhatsApp notifications
# mock | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Billing
# development | paystack | mpesa
BILLING_PROVIDER=development
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# Defaults
DEFAULT_COUNTRY=KE
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_VAT_RATE=16
